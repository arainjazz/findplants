{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/server.js",
  "minify": true,
  "assets": {
    "directory": "dist/client"
  },
  "routes": [
    { "pattern": "plantspedia.club", "custom_domain": true },
    { "pattern": "www.plantspedia.club", "custom_domain": true }
  ],
  // 开日志留存。默认只有 `wrangler tail` 的实时流，终端一关就什么都没了 ——
  // 而一次生成要跑 3–10 分钟，指望全程挂着终端不现实。开了之后可以事后去
  // Dashboard → Workers & Pages → 本 Worker → Observability 里按时间/关键字查。
  // 免费版 20 万条/天、留存 3 天，对本站的量级绰绰有余。
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // ⏱️ **CPU 时间上限拉到平台最大值（5 分钟）。**
  //
  // Queues 消费者每次调用有 15 分钟**挂钟**，但 CPU 时间是另一条线，默认仍是 30 秒
  // （Workers Paid 默认值；官方 limits 页写明可调到 300,000 ms 上限）。超了之后
  // isolate 会被**直接终止**——不抛异常、不走 catch，于是 runQueuedJob 那句
  // `jobs.fail()` 根本没机会执行：任务行永远停在 running，前端只能靠「连续两分钟
  // 没心跳」猜它死了。用户 2026-07-30 报的「金叶详页生成中断」在库里正是这个样子
  // （两条 gold_page 行：p12「正在检索并转存配图」跑了 114 秒、p44「撰稿 1/4」跑了
  // 260 秒，都没有 error、没有终态）。
  //
  // 金叶一趟要转存 18 张图 + 4 轮长文 JSON 解析 + 拼 150KB HTML，累计 CPU 逼近
  // 30 秒完全可能。**按用量计费，抬高上限本身不额外花钱**，所以这条没有下行风险。
  // ⚠️ 它是「拆掉一个已知的天花板」，不等于已经证实这就是当时的死因 ——
  // 真正的死因写在 Cloudflare Observability 日志里（按那两个时间点查）。
  "limits": {
    "cpu_ms": 300000
  },

  // 长任务队列。「进一步生成草稿」「金叶详页」冷启动要 3–10 分钟，而 waitUntil 只有
  // 30 秒上限（生产探针实测 26 秒被掐）。Queues 消费者每次调用有 15 分钟挂钟，
  // 且不要求 Workers Paid（官方 limits 页：限制对免费版同样适用，仅消息保留期不同）。
  //
  // ⚠️ 首次部署前必须先建队列，否则 deploy 会因绑定不存在而失败：
  //     npx wrangler queues create plant-jobs
  //     npx wrangler queues create plant-jobs-dlq
  "queues": {
    "producers": [{ "queue": "plant-jobs", "binding": "PLANT_JOBS" }],
    "consumers": [
      {
        "queue": "plant-jobs",
        // 一次只取一条：每个任务本身就要跑好几分钟，攒批毫无意义，
        // 反而会让先到的任务干等后面的凑批。
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        // 生成失败已经写进任务行、也已经烧过 token 了，重投只会再烧一遍。
        // 留 1 次是为了覆盖「消费者启动阶段就崩」这种没真正跑过的情况。
        "max_retries": 1,
        "dead_letter_queue": "plant-jobs-dlq"
      },
      // 🪦 **死信队列也要有消费者。**
      //
      // 没有它的时候，一个被平台掐死的任务（CPU/内存超限 → isolate 直接终止，
      // 来不及写 error）会这样收场：重投一次 → 多半同样被掐 → 进 DLQ → **无人过问**，
      // 任务行永远躺在 running。前端只好靠「连续两分钟没心跳」去猜，报出来的
      // 「多半是模型那端长时间不返回」还是个错误归因。
      //
      // 接上消费者之后，最后一次失败会被如实写成任务的终态，用户看到的是
      // 「服务端执行被中止」而不是心跳猜测，管理后台的任务记录里也留得下这一条。
      {
        "queue": "plant-jobs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // 这里只做一次写库标记，失败重投没有意义。
        "max_retries": 0
      }
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://ianlasfsfuaibqldkfyb.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_uYxfH-YXkYmJqbcSupkDYA_3bVvoHHg",
    "AI_MODEL": "gemini-3-flash-preview"
  }
}
